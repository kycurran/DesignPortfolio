---
import '../components/styles.css';
const { pageTitle } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/ButterflyFavicon.svg" />

    <!-- LOAD FONTS -->
    <link rel="stylesheet" href="https://use.typekit.net/noo6qgi.css">

    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>

  <body>
    <!-- PAGE TITLE -->
    <h1>Kylan Curran</h1>

    <!-- NAVIGATION -->
    <nav class="nav-bar">
      <ul>
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/about" class="nav-link">About</a></li>
        <li>
          <a
            href="https://www.redbubble.com/people/KylanJ"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
          >
            Shop
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/kylan-curran-bab28a312"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
          >
            Connect
          </a>
        </li>

        <!-- THEME TOGGLE -->
        <li>
          <button
            id="theme-toggle"
            aria-label="Toggle theme"
            title="Toggle theme"
          >
            🌙
          </button>
        </li>
      </ul>
    </nav>

    <!-- MAIN CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer>
      &copy; 2025 Kylan Curran. All rights reserved.
    </footer>

    <!-- THEME TOGGLE SCRIPT -->
    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      const root = document.documentElement;

      // Load saved theme
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        root.setAttribute('data-theme', savedTheme);
        toggle.textContent = savedTheme === 'dark' ? '☀️' : '🌙';
      }

      toggle.addEventListener('click', () => {
        const isDark = root.getAttribute('data-theme') === 'dark';
        const nextTheme = isDark ? 'light' : 'dark';

        root.setAttribute('data-theme', nextTheme);
        toggle.textContent = nextTheme === 'dark' ? '☀️' : '🌙';
        localStorage.setItem('theme', nextTheme);
      });
    </script>
  </body>
</html>
