---
import '../components/styles.css';
const { pageTitle } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/ButterflyFavicon.svg" />

    <!-- Fonts -->
    <link rel="stylesheet" href="https://use.typekit.net/noo6qgi.css" />

    <title>{pageTitle}</title>

<script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('theme');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- TOGGLE FUNCTION -->
    <script is:inline>
      function toggleTheme() {
        const html = document.documentElement;
        html.classList.toggle('dark');
        localStorage.setItem(
          'theme',
          html.classList.contains('dark') ? 'dark' : 'light'
        );
      }
    </script>
  </head>

  <body>
    <h1>Kylan Curran</h1>

    <!-- NAV -->
    <nav class="nav-bar">
      <ul>
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/about" class="nav-link">About</a></li>
        <li>
          <a href="https://www.redbubble.com/people/KylanJ" target="_blank" class="nav-link">
            Shop
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/kylan-curran-bab28a312" target="_blank" class="nav-link">
            Connect
          </a>
        </li>
        <li>
          <button
            class="theme-toggle"
            aria-label="Toggle theme"
            onclick="toggleTheme()"
          ></button>
        </li>
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      &copy; 2025 Kylan Curran. All rights reserved.
    </footer>
  </body>
</html>
