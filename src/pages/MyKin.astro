import gardens1 from '../assets/MyKin/MyKinTshirts/gardens1.jpg';
import gardens2 from '../assets/MyKin/MyKinTshirts/gardens2.jpg';
import pirate1 from '../assets/MyKin/MyKinTshirts/pirate1.jpg';
import pirate2 from '../assets/MyKin/MyKinTshirts/pirate2.jpg';
import reaper1 from '../assets/MyKin/MyKinTshirts/reaper1.jpg';
