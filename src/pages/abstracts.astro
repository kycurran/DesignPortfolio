---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import iteration1 from '../assets/abstracts/iteration-2.jpg';
import iteration2 from '../assets/abstracts/iteration-3.jpg';
import iteration3 from '../assets/abstracts/iteration-4.jpg';
